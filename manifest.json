{
  "manifest_version": 3,
  "name": "Semanthinks",
  "version": "0.1.0",
  "description": "An English-Tagalog distraction-free academic browsing helper.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Semanthinks", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle"
  }]
}
